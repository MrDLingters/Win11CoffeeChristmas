theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #443135
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100

		prefix = 1

		text
		{
			normal = #F4E2CB
			select = #F4E2CB
			normal-disabled = #B08B59
			select-disabled = #F4E2CB
		}

		back
		{
			select = #B08B59
			select-disabled = #9A9344
		}
	}

	// font
	// {
	// 	size = 14
	// 	name = "Segoe UI Variable Text"
	// 	weight = 3
	// 	italic = 0
	// }

	border
	{
		enabled = true
		size = 2
		color = #B08B59
		opacity = 100
		radius = 6
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #11111b
	}

	separator
	{
		size = 1
		color = #443135
	}

	symbol
	{
		normal = #F4E2CB
		select = #F4E2CB
		normal-disabled = #B08B59
		select-disabled = #B08B59
	}

	image
	{
		enabled = false
		color = [#F4E2CB, #F4E2CB, #F4E2CB]
	}
}